[alias]
    br = branch
    ci = commit
    cm = commit -m
    dt = difftool
    last = log -1 HEAD --stat --patch
    rv = remote -v
    root = rev-parse --show-superproject-working-tree --show-toplevel
    st = status -sb
[commit]
    verbose = true
[core]
    hooksPath = ~/.config/git/hooks
[credential]
    helper = store --file ~/.local/share/git/credentials
[diff]
    tool = vimdiff
[difftool]
    prompt = false
    trustExitCode = true
[fetch]
    prune = true
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[init]
    # templatedir = ~/.config/git/templates
    defaultBranch = main
[merge]
    ff = only
[pager]
    branch = false
[push]
    autoSetupRemote = true
[user]
    name = Eugene Rinaldi
    email = eugene@sifters.net
