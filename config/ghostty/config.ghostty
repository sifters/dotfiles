font-size = 11
font-family = "Hack Nerd Font Mono"
theme = "Banana Blueberry"
window-width = 160
window-height = 64
bell-features = no-attention,no-title

# Downgrade terminal to support enterprise hosts
term = xterm-256color

# MacOS Font Settings
font-thicken = true

# Include local overrides
config-file = ?ghostty_local
