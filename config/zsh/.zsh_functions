function cdg {
  local target

  # Check if we are in a submodule and retrieve the superproject root first
  target=$(git rev-parse --show-superproject-working-tree 2>/dev/null)

  # If empty, fall back to the current repository's top level
  if [[ -z "$target" ]]; then
    target=$(git rev-parse --show-toplevel 2>/dev/null)
  fi

  if [[ -n "$target" ]]; then
    echo "Navigating to $target"
    cd "$target"
  else
    echo "Not inside a git repository." >&2
    return 1
  fi
}

if command -v eza &> /dev/null; then
    _eza_flags=(--icons=always --group-directories-first)
    ls()    { eza -1                "${_eza_flags[@]}" "$@" }
    ll()    { eza -1 -a             "${_eza_flags[@]}" "$@" }
    lll()   { eza -l -a -h --git    "${_eza_flags[@]}" "$@" }
    lt()    { eza --tree --level=2  "${_eza_flags[@]}" "$@" }
    tree()  { eza --tree            "${_eza_flags[@]}" "$@" }
else
    # Fallback: detect GNU vs BSD ls (Linux vs macOS default)
    if ls --color=auto / &> /dev/null; then
        _ls_flags=(--color=auto --group-directories-first)
    else
        # BSD ls (macOS default)
        _ls_flags=(-G)
    fi
    ls()    { LC_COLLATE=C command ls "${_ls_flags[@]}" "$@" }
    ll()    { LC_COLLATE=C command ls -1AF "${_ls_flags[@]}" "$@" }
    lll()   { LC_COLLATE=C command ls -lAhF --color=always "$@" }
    lt()    { LC_COLLATE=C command tree -L 2 "$@" }
fi

function sudo() {
    command sudo --preserve-env=ZDOTDIR,STARSHIP_CONFIG -s "$@"
}


